{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src next.config.ts scripts *.md",
    "format:check": "prettier --check src next.config.ts scripts *.md",
    "test:integration": "node --test scripts/integration.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@headlessui/react": "2.2.10",
    "@react-pdf/renderer": "4.9.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.11.0",
    "swagger-ui-dist": "5.35.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
